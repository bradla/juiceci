<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tessera.App.ViewModels"
        x:Class="Tessera.App.Views.CalculationWindow"
        x:DataType="vm:CalculationViewModel"
        Title="{Binding Heading}"
        Width="640" Height="400" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBrush}">
  <DockPanel Margin="20,16,20,18">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
      <Button x:Name="OkButton" Classes="accent" Content="Save" MinWidth="88" HorizontalContentAlignment="Center" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" HorizontalContentAlignment="Center" IsCancel="True" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Padding="10,6" CornerRadius="4" Background="#FDE7E4" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#A4262C" />
    </Border>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,16,Auto,*" Margin="0,0,0,10">
      <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,10,0" />
      <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding Name}" />
      <TextBlock Grid.Column="3" Text="Table" VerticalAlignment="Center" Margin="0,0,10,0" IsVisible="{Binding IsColumn}" />
      <ComboBox Grid.Column="4" HorizontalAlignment="Stretch" ItemsSource="{Binding Tables}" SelectedItem="{Binding Table}"
                IsVisible="{Binding IsColumn}" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding Hint}" />
    <TextBox Text="{Binding Expression}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="monospace" VerticalContentAlignment="Top" />
  </DockPanel>
</Window>
