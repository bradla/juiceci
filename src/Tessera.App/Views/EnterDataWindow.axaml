<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tessera.App.ViewModels"
        x:Class="Tessera.App.Views.EnterDataWindow"
        x:DataType="vm:EnterDataViewModel"
        Title="Create table"
        Width="640" Height="460" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBrush}">
  <DockPanel Margin="20,16,20,18">
    <TextBlock DockPanel.Dock="Top" Text="Create table" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
      <Button x:Name="OkButton" Classes="accent" Content="Load" MinWidth="88" HorizontalContentAlignment="Center" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" HorizontalContentAlignment="Center" IsCancel="True" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Padding="10,6" CornerRadius="4" Background="#FDE7E4" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#A4262C" />
    </Border>
    <TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="0,6,0,0" Text="{Binding Summary}" />
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
      <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,10,0" />
      <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding Name}" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
               Text="Type or paste rows, the first row naming the columns. Separate values with tabs (as when pasting from a spreadsheet) or commas." />
    <TextBox Text="{Binding Text}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="monospace"
             VerticalContentAlignment="Top" PlaceholderText="Region,Target&#10;North,1200&#10;South,950" />
  </DockPanel>
</Window>
