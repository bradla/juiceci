<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource IconBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>

  <Style Selector="TextBlock.paneTitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="12,10,12,6" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>

  <!-- Flat buttons used in the top bar, rails and panes. -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
  <Style Selector="Button.flat:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.flat:disabled Path.icon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Start-screen source cards. -->
  <Style Selector="Button.card">
    <Setter Property="Width" Value="128" />
    <Setter Property="Height" Value="118" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,0,14,14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.card Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
  </Style>

  <!-- Start-screen recommendation cards. -->
  <Style Selector="Button.recommend">
    <Setter Property="Width" Value="264" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,0,14,14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.recommend:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Border.tile">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.tile Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>

  <!-- Collapsible start-screen section headers: a chevron that turns when collapsed. -->
  <Style Selector="ToggleButton.section">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4" />
  </Style>
  <Style Selector="ToggleButton.section:checked /template/ ContentPresenter, ToggleButton.section:pointerover /template/ ContentPresenter, ToggleButton.section:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="ToggleButton.section Path.chevron">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
  </Style>
  <Style Selector="ToggleButton.section:unchecked Path.chevron">
    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
  </Style>

  <!-- The "Recent" pill above the recent-reports list. -->
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource PillBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,5" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PillTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.pill Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource PillTextBrush}" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- View tab panes beside the Filters pane. -->
  <Style Selector="Border.viewPane">
    <Setter Property="Width" Value="240" />
    <Setter Property="Background" Value="{DynamicResource PaneBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Button.layer.current">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <!-- View ribbon: toggles that stay pressed while their pane or option is on. -->
  <Style Selector="ToggleButton.ribbon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.ribbon:checked /template/ ContentPresenter, ToggleButton.ribbon:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
  </Style>
  <Style Selector="ToggleButton.ribbon TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.ribbon Path.icon">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Options dialog. -->
  <Style Selector="TextBlock.optionsGroup">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="12,12,0,4" />
  </Style>
  <Style Selector="ListBox.optionsNav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.optionsNav ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.optionsNav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>
  <Style Selector="StackPanel.optionsBody TextBlock.h">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,14,0,4" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Path.info">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
  </Style>

  <!-- Design tab: theme tiles -->
  <Style Selector="Button.themeTile">
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- Visualizations gallery: Power BI's small square buttons, six to a row. -->
  <Style Selector="Button.vgallery">
    <Setter Property="Width" Value="39" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,2,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.vgallery Path.icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.vgallery:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.vgallery:disabled Path.icon, Button.vgallery:disabled TextBlock">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.vgallery TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Visual-type picker buttons. -->
  <Style Selector="Button.vtype">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.vtype.current">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Field wells. -->
  <Style Selector="Border.well">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Border.well.dropTarget">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- Left view rail. -->
  <Style Selector="Button.rail">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="6,6,6,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.rail.current">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Button.rail.current Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Sheet-style table tabs in the data view. -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Button.tab.current">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Power BI-style page tabs under the canvas, and the green new-page button. -->
  <Style Selector="Button.pageTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1,0,1,3" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="22,9" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.pageTab.current">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.newPage">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="46" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.newPage Path.icon">
    <Setter Property="Stroke" Value="White" />
    <Setter Property="StrokeThickness" Value="2.4" />
  </Style>

  <!-- Collapsed side panes: a narrow strip with a vertical title. -->
  <Style Selector="Button.strip">
    <Setter Property="Width" Value="32" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Build / Format tabs in the Visualizations pane. -->
  <Style Selector="Button.paneTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Button.paneTab.current">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.paneTab.current Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Data pane tree rows and Filters pane cards. -->
  <Style Selector="ToggleButton.treeRow, ToggleButton.flatToggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="ToggleButton.flatToggle">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ToggleButton.treeRow:checked /template/ ContentPresenter, ToggleButton.flatToggle:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.treeRow:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ToggleButton.treeRow:checked /template/ ContentPresenter, ToggleButton.treeRow:checked:pointerover /template/ ContentPresenter, ToggleButton.treeRow:pointerover /template/ ContentPresenter, ToggleButton.flatToggle:checked /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="ToggleButton.treeRow:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ToggleButton.treeRow:checked Path.icon, ToggleButton.flatToggle:checked Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource IconBrush}" />
  </Style>
  <Style Selector="CheckBox.fieldCheck">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,0,2,0" />
  </Style>
  <Style Selector="ToggleButton.treeRow Path.chevron">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
  </Style>
  <Style Selector="ToggleButton.treeRow:checked Path.chevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="ToggleButton.flatToggle:checked Path.chevron">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>
  <Style Selector="Border.filterCard">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <!-- Power BI's cards: a filter that keeps something turns grey and bold; the buttons show on hover. -->
  <Style Selector="Border.filterCard.active">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Border.filterCard TextBlock.cardName">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.filterCard TextBlock.cardSummary">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.filterCard.active TextBlock.cardName, Border.filterCard.active TextBlock.cardSummary">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.filterCard :is(Button).cardAction">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.filterCard:pointerover :is(Button).cardAction, Border.filterCard :is(Button).cardAction:checked">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Ribbon: tab strip and large command buttons in labelled groups. -->
  <Style Selector="Button.menuTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,6,12,4" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.menuTab.current">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.ribbon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ribbon:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.ribbon:disabled Path.icon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.ribbon Path.icon">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="0,2,0,4" />
  </Style>
  <Style Selector="Button.ribbon TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ribbonSmall">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="Button.ribbonSmall:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.ribbonSmall:disabled Path.icon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="ToggleButton.ribbonSmall">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="ToggleButton.ribbonSmall:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ToggleButton.ribbonSmall Path.icon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>
  <Style Selector="Button.ribbon:disabled TextBlock">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.ribbonSmall Path.icon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>
  <Style Selector="Button.ribbonSmall TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.groupLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2,0,2" />
  </Style>
  <Style Selector="Border.groupSep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
    <Setter Property="Margin" Value="6,6" />
  </Style>

  <Style Selector="Border.fieldRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.fieldRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- Dense grids for tables and the table view. -->
  <Style Selector="DataGrid">
    <Setter Property="RowHeight" Value="26" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
</Styles>
